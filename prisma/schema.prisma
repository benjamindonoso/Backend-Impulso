generator client {
  provider = "prisma-client-js"

}

datasource db {
  provider = "postgresql" // o "mysql", "sqlite", etc.
  url      = env("DATABASE_URL")
}

model Mesociclo {
  id              Int      @id @default(autoincrement())
  nombre          String   
  orden           Int      
  clienteId       Int
  cliente         Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  rutinas         Rutina[] 
  createdAt       DateTime @default(now())
}

model Administrador {
  id                  Int      @id @default(autoincrement())

  nombre              String

  email               String   @unique

  passwordHash        String

  rol                 String   @default("ADMIN_GYM") // ADMIN_GYM | KINESIOLOGO | SUPERADMIN

  especialidad        String?

  registroProfesional String?

  auditorias          Auditoria[]
  evaluacionesKine    EvaluacionKine[]
  evolucionesKine     EvolucionKine[]

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Familia {
  id            Int      @id @default(autoincrement())

  nombre        String

  plan          String?

  activa        Boolean  @default(true)

  integrantes   Cliente[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Cliente {
  id                Int       @id @default(autoincrement())

  rut               String?   @unique

  nombre            String

  apellidoP          String
  apellidoM          String

  codigoQr          String?   @unique

  telefono          String?

  email             String?

  fechaNacimiento   DateTime?

  activo            Boolean   @default(true)

  esTitular         Boolean   @default(false)

  familiaId         Int?

  familia           Familia?  @relation(fields: [familiaId], references: [id])

  rutinas           Rutina[]

  mesociclos      Mesociclo[] 

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([nombre])
  @@index([apellidoP])
  @@index([apellidoM])
}

model Ejercicio {
  id              Int      @id @default(autoincrement())

  nombre          String    @unique

  descripcion     String?

  videoUrl        String?

  rutinas         RutinaEjercicio[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Rutina {
  id              Int      @id @default(autoincrement())

  nombre          String

  diaSemana       String?

  mesocicloId     Int

  mesociclo       Mesociclo @relation(fields: [mesocicloId], references: [id], onDelete: Cascade)

  descripcion     String?

  activa          Boolean  @default(true)

  clienteId       Int

  cliente         Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  ejercicios      RutinaEjercicio[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model RutinaEjercicio {
  id              Int      @id @default(autoincrement())

  rutinaId        Int

  ejercicioId     Int

  orden           Int

  series          Int

  repeticiones    Int

  peso            Float?

  descansoSeg     Int?

  observaciones   String?

  rutina          Rutina     @relation(fields: [rutinaId], references: [id], onDelete: Cascade)

  ejercicio       Ejercicio  @relation(fields: [ejercicioId], references: [id])

  createdAt       DateTime @default(now())

}

  model Auditoria {
  id          Int            @id @default(autoincrement())
  accion      String         
  entidad     String         
  
  adminId     Int
  admin       Administrador  @relation(fields: [adminId], references: [id])
  
  createdAt   DateTime       @default(now())
}

// =======================================================
// MÓDULO DE KINESIOLOGÍA (TABLAS AISLADAS DEL GIMNASIO)
// =======================================================

model PacienteKine {
  id                   Int              @id @default(autoincrement())
  rut                  String?          @unique
  nombre               String
  apellidoP            String
  apellidoM            String           @default("")
  fechaNacimiento      DateTime?
  telefono             String?
  email                String?
  prevision            String?
  ocupacion            String?
  medicoDerivante      String?
  diagnosticoMedico    String?
  motivoConsulta       String?
  antecedentesMorbidos String?
  estadoTratamiento    String           @default("EN_TRATAMIENTO") // EN_TRATAMIENTO | ALTA | PAUSADO
  activo               Boolean          @default(true)

  evaluaciones         EvaluacionKine[]
  evoluciones          EvolucionKine[]
  rutinasKine          RutinaKine[]

  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@index([nombre])
  @@index([apellidoP])
  @@index([activo])
}

model EvaluacionKine {
  id                   Int           @id @default(autoincrement())
  pacienteId           Int
  paciente             PacienteKine  @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  kinesiologoId        Int
  kinesiologo          Administrador @relation(fields: [kinesiologoId], references: [id])

  fecha                DateTime      @default(now())
  tipo                 String        @default("INICIAL") // INICIAL | REEVALUACION | ALTA
  zonaAfectada         String?
  anamnesis            String?
  evaReposo            Int?
  evaMovimiento        Int?
  rangoArticular       String?
  fuerzaMuscular       String?
  pruebasEspeciales    String?
  evaluacionPostural   String?
  diagnosticoKinesico  String?
  objetivos            String?
  planTratamiento      String?

  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@index([pacienteId, fecha])
}

model EvolucionKine {
  id            Int           @id @default(autoincrement())
  pacienteId    Int
  paciente      PacienteKine  @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  kinesiologoId Int
  kinesiologo   Administrador @relation(fields: [kinesiologoId], references: [id])

  numeroSesion  Int?
  fecha         DateTime      @default(now())
  asistencia    String        @default("ASISTIO") // ASISTIO | INASISTENCIA | REPROGRAMADA
  evaPre        Int?
  evaPost       Int?
  subjetivo     String?
  objetivo      String?
  analisis      String?
  plan          String?

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([pacienteId, fecha])
}

model EjercicioKine {
  id                   Int                   @id @default(autoincrement())
  nombre               String                @unique
  zonaCorporal         String?
  categoria            String?
  descripcion          String?
  indicacionesClinicas String?
  videoUrl             String?

  rutinas              RutinaKineEjercicio[]

  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
}

model RutinaKine {
  id                    Int                   @id @default(autoincrement())
  pacienteId            Int
  paciente              PacienteKine          @relation(fields: [pacienteId], references: [id], onDelete: Cascade)

  nombre                String
  fase                  String?
  frecuenciaSemana      String?
  indicacionesGenerales String?
  dolorMaximoTolerable  Int?
  activa                Boolean               @default(true)

  ejercicios            RutinaKineEjercicio[]

  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  @@index([pacienteId, activa])
}

model RutinaKineEjercicio {
  id              Int           @id @default(autoincrement())
  rutinaKineId    Int
  rutinaKine      RutinaKine    @relation(fields: [rutinaKineId], references: [id], onDelete: Cascade)
  ejercicioKineId Int
  ejercicioKine   EjercicioKine @relation(fields: [ejercicioKineId], references: [id])

  orden           Int
  series          Int
  repeticiones    Int
  duracionSeg     Int?
  peso            String?
  descansoSeg     Int?
  frecuencia      String?
  observaciones   String?

  createdAt       DateTime      @default(now())
}